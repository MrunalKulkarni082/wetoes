# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
# Public URL used in magic links (no trailing slash)
PUBLIC_URL=http://localhost:3000
# Set to true once served over HTTPS (makes cookies Secure)
COOKIE_SECURE=false
LLM_MODEL=qwen2.5:7b
# Max concurrent LLM generations / queued requests
LLM_CONCURRENCY=1
LLM_MAX_QUEUE=16
# Per-user LLM generations per day
LLM_DAILY_LIMIT=60
# Reject emails whose domain has no MX record
CHECK_EMAIL_DOMAIN=true
# Extra allowed browser origins, comma-separated
EXTRA_ORIGINS=
